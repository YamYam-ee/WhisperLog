{
  "name": "whisperlog",
  "productName": "WhisperLog",
  "version": "1.0.0",
  "description": "Spelar in, transkriberar och protokollför möten med Gemini",
  "author": "WhisperLog",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win portable",
    "icons": "node scripts/brand.js"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "ffmpeg-static": "^5.3.0",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "docx": "^9.11.0",
    "dompurify": "^3.4.17",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "app.whisperlog",
    "productName": "WhisperLog",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "WhisperLog.exe"
    }
  }
}
